# All variables are validated with zod at startup (packages/core/src/env.ts).
# Never commit real values. Copy to .env for local use.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The adapter rejects any other base URL unless PAYPAL_TEST_MODE=true.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# true only in e2e tests (points PAYPAL_API_BASE at the local test-stub)
PAYPAL_TEST_MODE=false

ANTHROPIC_API_KEY=
# Anthropic model id, e.g. a current Sonnet model
ALIBI_MODEL=

AG_STUDIO_LICENSE_KEY=
DATABASE_URL=

# Public deployment: submission disabled with a clear message
DEMO_READONLY=true
ALIBI_MAX_LLM_CALLS_PER_CASE=8
ALIBI_DEADLINE_WARN_HOURS=72
